# QitPit — copy to .env and fill in for production.
# Never commit the real .env file.

# Port the server listens on
PORT=3000

# Bind address. 127.0.0.1 when a reverse proxy (nginx/Caddy) sits in front.
HOST=127.0.0.1

# Set to "production" on a live server. Enables HSTS and Secure cookies.
NODE_ENV=production

# Public origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
SITE_URL=https://qitpit.com

# 64 hex characters, used to sign order confirmation links.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left unset, one is generated automatically into data/.secret
APP_SECRET=

# Optional: move the database and uploads off the project directory
# DATA_DIR=/var/lib/qitpit/data
# UPLOAD_DIR=/var/lib/qitpit/uploads

# ---------------------------------------------------------------- order email
# Optional. Leave blank and the site works exactly as before — orders still
# save, the admin panel still shows them; you just don't get a push notification.
#
# Works with any SMTP provider. Gmail example shown; a business mailbox
# (Zoho, your domain host) is usually better — Gmail caps at ~500 mails/day and
# needs 2-Step Verification enabled before it will issue an App Password
# (Google Account > Security > 2-Step Verification > App Passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourshop@gmail.com
SMTP_PASS=your-16-character-app-password
ORDER_EMAIL_TO=where-you-read-mail@example.com
ORDER_EMAIL_FROM=yourshop@gmail.com
